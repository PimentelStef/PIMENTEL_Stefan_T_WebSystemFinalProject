@* Views/Account/Login.cshtml *@
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Student Grade Management - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background: #f2f5f9;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
            }

            .login-card {
                background: white;
                width: 100%;
                max-width: 420px;
                padding: 32px;
                border-radius: 12px;
                box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
            }

            .login-title {
                color: #183153;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <main class="login-card">
        <h2 class="login-title text-center mb-2">Student Grade Management</h2>
        <p class="text-center text-secondary mb-4">Sign in to your account</p>

        <form id="loginForm">
            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <input id="email" type="email" class="form-control"
                       placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" type="password" class="form-control"
                       placeholder="Enter your password" required />
            </div>

            <div id="message" class="mb-3" role="alert"></div>

            <button id="loginButton" type="submit" class="btn btn-primary w-100">
                Log In
            </button>
        </form>
    </main>

    <script src="~/js/login.js"></script>
</body>
</html>