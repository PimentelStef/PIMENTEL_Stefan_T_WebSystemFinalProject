@{
    ViewData["Title"] = "Faculty Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Faculty Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <h1>Faculty Dashboard</h1>
        <p class="text-secondary">Welcome to the Student Grade Management System.</p>

        <div class="card p-4 mt-4">
            <h4>Grade Management</h4>
            <p>View all student grade records below.</p>

            <p id="status" class="text-secondary" role="status">
                Loading grades...
            </p>

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Student ID</th>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Grade</th>
                            <th>Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                            <th>Faculty ID</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="gradesTable"></tbody>
                </table>
            </div>
        </div>
        
        <div class="card p-4 mt-4">
            <h4>Add Student Grade</h4>
            <p class="text-secondary">
                Enter the student's grade information below.
            </p>

            <form id="addGradeForm">
                <div class="mb-3">
                    <label for="studentId" class="form-label">Student ID</label>
                    <input type="number" id="studentId" class="form-control"
                           min="1" required />
                </div>

                <div class="mb-3">
                    <label for="subjectCode" class="form-label">Subject Code</label>
                    <input type="text" id="subjectCode" class="form-control"
                           maxlength="30" required />
                </div>

                <div class="mb-3">
                    <label for="subjectName" class="form-label">Subject Name</label>
                    <input type="text" id="subjectName" class="form-control"
                           maxlength="200" required />
                </div>

                <div class="mb-3">
                    <label for="grade" class="form-label">Grade (0–100)</label>
                    <input type="number" id="grade" class="form-control"
                           min="0" max="100" step="1" required />
                </div>

                <div class="mb-3">
                    <label for="semester" class="form-label">Semester</label>
                    <input type="text" id="semester" class="form-control"
                           maxlength="50" required />
                </div>

                <div class="mb-3">
                    <label for="schoolYear" class="form-label">School Year</label>
                    <input type="text" id="schoolYear" class="form-control"
                           maxlength="20" required />
                </div>

                <button type="submit" id="addGradeButton"
                        class="btn btn-primary">
                    Add Grade
                </button>
            </form>

            <p id="addGradeMessage" class="mt-3" role="status"></p>
        </div>
        
        <div class="card p-4 mt-4" id="editGradeCard" style="display: none;">
            <h4>Edit Student Grade</h4>

            <form id="editGradeForm">
                <input type="hidden" id="editGradeId" />

                <div class="mb-3">
                    <label for="editStudentId" class="form-label">Student ID</label>
                    <input type="number" id="editStudentId" class="form-control"
                           min="1" required />
                </div>

                <div class="mb-3">
                    <label for="editSubjectCode" class="form-label">Subject Code</label>
                    <input type="text" id="editSubjectCode" class="form-control"
                           maxlength="30" required />
                </div>

                <div class="mb-3">
                    <label for="editSubjectName" class="form-label">Subject Name</label>
                    <input type="text" id="editSubjectName" class="form-control"
                           maxlength="200" required />
                </div>

                <div class="mb-3">
                    <label for="editGradeValue" class="form-label">Grade (0–100)</label>
                    <input type="number" id="editGradeValue" class="form-control"
                           min="0" max="100" step="1" required />
                </div>

                <div class="mb-3">
                    <label for="editSemester" class="form-label">Semester</label>
                    <input type="text" id="editSemester" class="form-control"
                           maxlength="50" required />
                </div>

                <div class="mb-3">
                    <label for="editSchoolYear" class="form-label">School Year</label>
                    <input type="text" id="editSchoolYear" class="form-control"
                           maxlength="20" required />
                </div>

                <button type="submit" class="btn btn-primary" id="saveEditButton">
                    Save Changes
                </button>
                <button type="button" class="btn btn-secondary" id="cancelEditButton">
                    Cancel
                </button>
            </form>

            <p id="editGradeMessage" class="mt-3" role="status"></p>
        </div>

        <button id="logoutButton" class="btn btn-danger mt-4">
            Log Out
        </button>
    </div>

    <script>
            const token = sessionStorage.getItem("jwtToken");
            const roles = JSON.parse(
                sessionStorage.getItem("userRoles") || "[]"
            );

            if (!token || !roles.includes("Faculty")) {
                window.location.replace("/Account/Login");
            } else {
                loadGrades();
            }

            async function loadGrades() {
                const status = document.getElementById("status");
                const gradesTable = document.getElementById("gradesTable");

                try {
                    const response = await fetch(
                        "http://localhost:5200/api/grades",
                        {
                            method: "GET",
                            headers: {
                                "Authorization": `Bearer ${token}`
                            }
                        }
                    );

                    if (response.status === 401 || response.status === 403) {
                        status.textContent =
                            "Access denied. Please log in again with a faculty account.";
                        return;
                    }

                    if (!response.ok) {
                        throw new Error("Failed to retrieve grades.");
                    }

                    const grades = await response.json();
                    gradesTable.replaceChildren();

                    if (grades.length === 0) {
                        status.textContent = "No grade records found.";
                        return;
                    }

                    for (const grade of grades) {
                        const row = document.createElement("tr");

                        const values = [
                            grade.studentId,
                            grade.subjectCode,
                            grade.subjectName,
                            grade.grade,
                            grade.remarks,
                            grade.semester,
                            grade.schoolYear,
                            grade.facultyId
                        ];

                    for (const value of values) {
                        const cell = document.createElement("td");
                            cell.textContent = value ?? "";
                            row.appendChild(cell);
                        }
                        
                        const actionsCell = document.createElement("td");

                        const editButton = document.createElement("button");
                        editButton.type = "button";
                        editButton.textContent = "Edit";
                        editButton.className = "btn btn-warning btn-sm";

                        editButton.addEventListener("click", () => {
                        editGrade(grade);
                        });

                        actionsCell.appendChild(editButton);

                        const deleteButton = document.createElement("button");
                        deleteButton.type = "button";
                        deleteButton.textContent = "Delete";
                        deleteButton.className = "btn btn-danger btn-sm ms-2";

                        deleteButton.addEventListener("click", async () => {
                            const confirmed = confirm(
                                `Are you sure you want to delete grade ${grade.gradeId} for ${grade.subjectCode}?`
                            );

                            if (!confirmed) {
                                return;
                            }

                            try {
                                const response = await fetch(
                                    `http://localhost:5200/api/grades/${grade.gradeId}`,
                                    {
                                        method: "DELETE",
                                        headers: {
                                            "Authorization": `Bearer ${token}`
                                        }
                                    }
                                );

                                if (!response.ok) {
                                    let data = {};
                                    try {
                                        data = await response.json();
                                    } catch {
                                        // The response may not contain JSON.
                                    }

                                    alert(data.message || "Failed to delete the grade.");
                                    return;
                                }

                                alert("Grade deleted successfully!");
                                await loadGrades();
                            } catch (error) {
                                console.error(error);
                                alert("Unable to connect to the API. Check that it is running.");
                            }
                        });

                        actionsCell.appendChild(deleteButton);
                        row.appendChild(actionsCell);

                        gradesTable.appendChild(row);
                    }

                    status.textContent = `Loaded ${grades.length} grade record(s).`;
                } catch (error) {
                    console.error(error);
                    status.textContent =
                        "Unable to load grades. Check that the API is running.";
                }
            }
            
            // Handle the Add Grade form submission.
            document.getElementById("addGradeForm").addEventListener("submit", async (event) => {
                event.preventDefault();

                const message = document.getElementById("addGradeMessage");
                const button = document.getElementById("addGradeButton");

                message.textContent = "";
                message.className = "mt-3 text-danger";
                button.disabled = true;

                const gradeData = {
                    studentId: Number(document.getElementById("studentId").value),
                    subjectCode: document.getElementById("subjectCode").value.trim(),
                    subjectName: document.getElementById("subjectName").value.trim(),
                    grade: Number(document.getElementById("grade").value),
                    semester: document.getElementById("semester").value.trim(),
                    schoolYear: document.getElementById("schoolYear").value.trim()
                };

                try {
                    const response = await fetch("http://localhost:5200/api/grades", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Authorization": `Bearer ${token}`
                        },
                        body: JSON.stringify(gradeData)
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        message.textContent = data.message || "Failed to add grade. Please check your entries.";
                        return;
                    }

                    message.className = "mt-3 text-success";
                    message.textContent = "Grade added successfully! Remarks: " + data.remarks;

                    document.getElementById("addGradeForm").reset();

                    await loadGrades();
                } catch (error) {
                    console.error(error);
                    message.textContent = "Unable to connect to the API. Check that it is running.";
                } finally {
                    button.disabled = false;
                }
            });
            
            document.getElementById("editGradeForm").addEventListener("submit", async (event) => {
                event.preventDefault();

                const message = document.getElementById("editGradeMessage");
                const button = document.getElementById("saveEditButton");

                message.textContent = "";
                message.className = "mt-3 text-danger";
                button.disabled = true;

                const gradeId = document.getElementById("editGradeId").value;

                const updatedGrade = {
                    studentId: Number(document.getElementById("editStudentId").value),
                    subjectCode: document.getElementById("editSubjectCode").value.trim(),
                    subjectName: document.getElementById("editSubjectName").value.trim(),
                    grade: Number(document.getElementById("editGradeValue").value),
                    semester: document.getElementById("editSemester").value.trim(),
                    schoolYear: document.getElementById("editSchoolYear").value.trim()
                };

                try {
                    const response = await fetch(`http://localhost:5200/api/grades/${gradeId}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                            "Authorization": `Bearer ${token}`
                        },
                        body: JSON.stringify(updatedGrade)
                    });

                    const data = response.status === 204 ? {} : await response.json();

                    if (!response.ok) {
                        message.textContent = data.message || "Failed to update grade.";
                        return;
                    }

                    message.className = "mt-3 text-success";
                    message.textContent = "Grade updated successfully! Remarks: " + data.remarks;

                    document.getElementById("editGradeCard").style.display = "none";

                    await loadGrades();
                } catch (error) {
                    console.error(error);
                    message.textContent = "Unable to connect to the API. Check that it is running.";
                } finally {
                    button.disabled = false;
                }
            });

            function editGrade(grade) {
                document.getElementById("editGradeCard").style.display = "block";

                document.getElementById("editGradeId").value = grade.gradeId;
                document.getElementById("editStudentId").value = grade.studentId;
                document.getElementById("editSubjectCode").value = grade.subjectCode;
                document.getElementById("editSubjectName").value = grade.subjectName;
                document.getElementById("editGradeValue").value = grade.grade;
                document.getElementById("editSemester").value = grade.semester;
                document.getElementById("editSchoolYear").value = grade.schoolYear;

                document.getElementById("editGradeMessage").textContent = "";

                document.getElementById("editGradeCard").scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }

            document.getElementById("cancelEditButton").addEventListener("click", () => {
                document.getElementById("editGradeForm").reset();
                document.getElementById("editGradeCard").style.display = "none";
                document.getElementById("editGradeMessage").textContent = "";
            });

            document.getElementById("logoutButton").addEventListener("click", () => {
                sessionStorage.removeItem("jwtToken");
                sessionStorage.removeItem("userRoles");
                window.location.replace("/Account/Login");
            });
    </script>

</body>
</html>