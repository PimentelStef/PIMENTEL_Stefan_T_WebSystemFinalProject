@{
    ViewData["Title"] = "Student Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <h1>Student Dashboard</h1>
        <p class="text-secondary">View your academic grades below.</p>

        <div class="card p-4 mt-4">
            <h4>My Grades</h4>
            <div id="message" class="my-2" role="status">Loading grades...</div>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Subject Code</th>
                            <th>Subject</th>
                            <th>Grade</th>
                            <th>Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                        </tr>
                    </thead>
                    <tbody id="gradesTable"></tbody>
                </table>
            </div>
        </div>

        <button id="logoutButton" class="btn btn-danger mt-4">
            Log Out
        </button>
    </div>

    <script>
            const token = sessionStorage.getItem("jwtToken");
            const roles = JSON.parse(
                sessionStorage.getItem("userRoles") || "[]"
            );

            if (!token || !roles.includes("Student")) {
                window.location.replace("/Account/Login");
            } else {
                loadGrades();
            }

            async function loadGrades() {
                const message = document.getElementById("message");
                const table = document.getElementById("gradesTable");

                try {
                    const response = await fetch(
                        "http://localhost:5200/api/grades/my-grades",
                        {
                            headers: {
                                "Authorization": `Bearer ${token}`
                            }
                        }
                    );

                    if (response.status === 401 || response.status === 403) {
                        message.textContent =
                            "Your session is invalid or you do not have permission.";
                        return;
                    }

                    if (!response.ok) {
                        throw new Error("Could not load grades.");
                    }

                    const grades = await response.json();
                    table.replaceChildren();

                    if (grades.length === 0) {
                        message.textContent = "No grades found.";
                        return;
                    }

                    message.textContent = "";

                    for (const grade of grades) {
                        const row = document.createElement("tr");

                        const values = [
                            grade.subjectCode,
                            grade.subjectName,
                            grade.grade,
                            grade.remarks,
                            grade.semester,
                            grade.schoolYear
                        ];

                        for (const value of values) {
                            const cell = document.createElement("td");
                            cell.textContent = value ?? "";
                            row.appendChild(cell);
                        }

                        table.appendChild(row);
                    }
                } catch (error) {
                    message.textContent =
                        "Unable to load grades. Check that the API is running.";
                }
            }

            document.getElementById("logoutButton").addEventListener("click", () => {
                sessionStorage.removeItem("jwtToken");
                sessionStorage.removeItem("userRoles");
                window.location.replace("/Account/Login");
            });
    </script>
</body>
</html>